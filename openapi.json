  "components": {
    "schemas": {
      "ChannelType": {
        "type": "string",
        "enum": [
          "email",
          "sms",
          "whatsapp",
          "web"
        ],
        "title": "ChannelType",
        "description": "Supported communication channels."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageBatchIngest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageIngest"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "MessageBatchIngest",
        "description": "Request schema for batch message ingestion.",
        "example": {
          "messages": [
            {
              "body": "Need help with scheduling",
              "channel": "email",
              "sender": "parent1@example.com"
            },
            {
              "body": "Confirming tomorrow's session",
              "channel": "sms",
              "sender": "+1234567890"
            }
          ]
        }
      },
      "MessageIngest": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/ChannelType",
            "description": "Communication channel"
          },
          "sender": {
            "type": "string",
            "title": "Sender",
            "description": "Sender identifier (email, phone number)"
          },
          "recipient": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipient",
            "description": "Recipient identifier"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject",
            "description": "Message subject (email only)"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "title": "Body",
            "description": "Message body/content"
          },
          "raw_content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Content",
            "description": "Raw message data for debugging"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Link to existing session"
          },
          "received_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Received At",
            "description": "When message was received"
          }
        },
        "type": "object",
        "required": [
          "channel",
          "sender",
          "body"
        ],
        "title": "MessageIngest",
        "description": "Request schema for ingesting messages from multiple channels.\nSupports email, SMS, and WhatsApp integration.",
        "examples": [
          {
            "body": "My child needs help with math homework this Thursday.",
            "channel": "email",
            "received_at": "2025-11-13T10:00:00Z",
            "recipient": "mew@assistant.com",
            "sender": "parent@example.com",
            "subject": "Need tutoring help"
          },
          {
            "body": "Can we schedule a session for tomorrow?",
            "channel": "sms",
            "sender": "+1234567890",
            "session_id": 42
          },
          {
            "body": "Thank you for the tutoring session!",
            "channel": "whatsapp",
            "sender": "+1234567890",
            "session_id": 42
          }
        ]
      },
      "MessageResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
