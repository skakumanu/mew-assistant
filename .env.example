# Environment Configuration for Mew Assistant

# Database Configuration
# Option 1: PostgreSQL with Podman (recommended for production)
DATABASE_URL=postgresql://mew_user:mew_password@localhost:5432/mew_assistant

# Option 2: SQLite (for development/testing - no Podman needed)
# DATABASE_URL=sqlite:///./mew_assistant.db

# Application Settings
APP_NAME=Mew Assistant
APP_VERSION=1.0.0
DEBUG=False

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
RELOAD=False

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Cooldown Settings (in hours)
DEFAULT_COOLDOWN_HOURS=24
TUTORING_COOLDOWN_HOURS=24
SCHEDULING_COOLDOWN_HOURS=12
SUMMARY_COOLDOWN_HOURS=48

# Priority Period Settings (24-hour format)
MORNING_PREP_START=07:00
MORNING_PREP_END=09:00
AFTER_SCHOOL_START=15:00
AFTER_SCHOOL_END=18:00
EVENING_ROUTINE_START=19:00
EVENING_ROUTINE_END=21:00

# Multi-Channel Integration (Optional)
# Email Configuration
EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@mew-assistant.org

# SMS Configuration (Twilio)
SMS_ENABLED=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Configuration (Twilio)
WHATSAPP_ENABLED=False
WHATSAPP_FROM=whatsapp:+14155238886

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (Optional - for caching)
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0

# AI Integration (Optional - for enhanced summaries)
AI_ENABLED=False
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Monitoring (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Podman Configuration
# If running PostgreSQL in Podman, these settings are used by podman-start.sh
POSTGRES_USER=mew_user
POSTGRES_PASSWORD=mew_password
POSTGRES_DB=mew_assistant
POSTGRES_PORT=5432


# Email Configuration (SMTP/IMAP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password

# Twilio Configuration (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# AI Provider Configuration
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
AI_MODEL=gpt-4

# Google Calendar Configuration
GOOGLE_CREDENTIALS_FILE=path/to/google-credentials.json
GOOGLE_CALENDAR_ID=primary
